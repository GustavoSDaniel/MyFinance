# ====================================================================
# 🔐 CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (TEMPLATE)
# ====================================================================
#
# INSTRUÇÕES DE USO:
# 1. Crie uma cópia deste arquivo na raiz do projeto.
# 2. Renomeie a cópia para ".env" (sem o .example).
# 3. Preencha as variáveis abaixo com suas credenciais reais.
#
# ⚠️ IMPORTANTE:
# O arquivo ".env" real já está no .gitignore.
# JAMAIS commite suas senhas ou chaves reais no GitHub!
# ====================================================================

# ====================================================================
# 🗄️ BANCO DE DADOS PRINCIPAL (my-finance-db)
# ====================================================================
POSTGRES_DB=db
POSTGRES_USER=seu_usuario
POSTGRES_PASSWORD=sua_senha

# ====================================================================
# 🗄️ BANCO DE DADOS DO KEYCLOAK
# ====================================================================
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=seu_usuario_keycloak
KEYCLOAK_DB_PASSWORD=sua_senha_keycloak

# ====================================================================
# 👑 ADMINISTRADORES DO SISTEMA
# ====================================================================
# Lista de e‑mails separados por vírgula que terão permissões de admin
ADMIN_EMAILS=admin1@exemplo.com,admin2@exemplo.com

# ====================================================================
# 🌐 CORS (Cross-Origin Resource Sharing)
# ====================================================================
# Origem permitida para requisições front-end (React, Vue, etc.)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ====================================================================
# 🔐 KEYCLOAK ADMIN
# ====================================================================
KEYCLOAK_ADMIN=admin@exemplo.com
KEYCLOAK_ADMIN_PASSWORD=senha_admin_keycloak

# ====================================================================
# 🔐 CONFIGURAÇÕES DO CLIENTE KEYCLOAK (my-finance-app)
# ====================================================================
# Estas variáveis são usadas para comunicação entre a aplicação e o Keycloak
CLIENT_ID=my-finance-app
CLIENT_SECRET=seu_client_secret_gerado_no_keycloak
ISSUER_URI=http://localhost:5053/realms/app

# ====================================================================
# 📊 OBSERVABILIDADE (Grafana)
# ====================================================================
GF_SECURITY_ADMIN_PASSWORD=senha_grafana

# ====================================================================
# 🔧 ENDPOINTS ÚTEIS (apenas para referência – não são variáveis)
# ====================================================================
# Token endpoint:
# http://localhost:5053/realms/my-finance-app/protocol/openid-connect/token
#
# Account console:
# http://localhost:5053/realms/my-finance-app/account/