# ====================================================================
# 🔐 CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (TEMPLATE)
# ====================================================================
#
# INSTRUÇÕES DE USO:
# 1. Crie uma cópia deste arquivo na raiz do projeto.
# 2. Renomeie a cópia para ".env" (sem o .example).
# 3. Preencha as variáveis abaixo com suas credenciais reais.
#
# ⚠️ IMPORTANTE:
# O arquivo ".env" real já está no .gitignore.
# JAMAIS commite suas senhas ou chaves reais no GitHub!
# ====================================================================

# --- GOOGLE OAUTH2 CONFIGURATION ---
# Obtenha estas chaves no Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
#
# Tipo: OAuth 2.0 Client IDs
# Redirect URI (Padrão): http://localhost:5050/login/oauth2/code/google

CLIENT_ID=insira_seu_client_id_do_google_aqui
CLIENT_SECRET=insira_seu_client_secret_do_google_aqui

# --- Credenciais do Banco de Dados ------
POSTGRES_DB=seubancodedados
POSTGRES_USER=seuusuario
POSTGRES_PASSWORD=suasenha

# -- Lista de emails para ser ADMIN ---
ADMIN_EMAILS=EMAILS DE AMIN

# -- Senha da Observabilidade ---
GF_SECURITY_ADMIN_PASSWORD=admin